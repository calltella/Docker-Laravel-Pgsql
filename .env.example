# Docker Compose と bat/ 配下のスクリプト用設定。
# このファイルを .env にコピーし、パスとパスワードを環境に合わせて変更してください。
# Laravel アプリ自身の .env は LARAVEL_DIRECTORY 配下で別途設定してください。
# シェルから source するため、値に空白や特殊文字がある場合はシングルクォートで囲みます。

# ホスト上のソース配置先（実在するディレクトリの絶対パスに変更）。
# Laravel は /var/www/html/laravel、旧PHPは /var/www/html/legacy にマウントされます。
LARAVEL_DIRECTORY='/path/to/laravel'
LEGACY_PHP_DIRECTORY='/path/to/legacy'

# ホスト側の公開ポート。Nginx / pgAdmin のコンテナ側ポートはいずれも 80。
APP_PORT=80
PG_PORT=8080

# Compose の DOCKER_RESTART を参照するサービスに適用する再起動ポリシー。
# no: 自動再起動なし / on-failure: 異常終了時 / always: 常時 / unless-stopped: 手動停止時を除く。
# apline-sync-worker は unless-stopped、pgadmin4 は no に固定されています。
DOCKER_RESTART=unless-stopped

# PostgreSQL の初期化時に設定する postgres ユーザーのパスワード（必ず変更）。
# 既存のデータボリュームがある場合、この値の変更だけではDB側のパスワードは変わりません。
POSTGRES_PASSWORD='replace-with-a-strong-postgres-password'

# pgAdmin のイメージ名。LIBRAY は compose.yaml の既存の変数名に合わせた表記です。
# 運用時は利用するバージョンのタグを指定してください。
PGADMIN_IMAGE_LIBRAY=dpage/pgadmin4:latest

# pgAdmin の初回起動時に作成する管理者アカウント（パスワードは必ず変更）。
# PostgreSQL の接続ユーザーとは別のアカウントです。
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD='replace-with-a-strong-pgadmin-password'

# bat/ 配下のスクリプトが docker ps で検索するコンテナ名。
# compose.yaml の container_name に合わせて設定します。
LARAVEL_CONTAINER_NAME=php
DATABASE_CONTAINER_NAME=postgres

# バックアップの本番実行確認と、R2復元スクリプトの本番実行防止判定用。
# 本番環境では production に変更。Laravel アプリ側の APP_ENV とは別に設定が必要です。
APP_ENV=local

# prod-db-production-backup.sh でパスワード認証が必要な場合のみ設定。
# 未指定時はコンテナ内のローカル認証設定を使用します。
# 他の旧バックアップスクリプトでは受け渡し処理の修正が別途必要です。
# PGDUMP_PASSWORD='replace-with-the-postgres-password'

# prod-db-production-backup.sh の sudo 認証用（DBのパスワードとは別）。
# 設定すると対話入力を省略。未設定・空の場合は通常の sudo 認証を使用します。
# 実際のパスワードは .env にのみ記載し、chmod 600 .env で読み取りを制限してください。
SUDO_PASSWORD=
